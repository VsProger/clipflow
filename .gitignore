# === Xcode: сборка и производные данные ===
build/
DerivedData/
*.o
*.a
*.dSYM/
*.hmap
*.ipa
*.app
*.xcarchive

# === Xcode: пользовательское состояние ===
# xcuserdata содержит breakpoints, схемы и раскладку окон конкретного разработчика —
# в общий репозиторий это не нужно.
xcuserdata/
*.xcuserstate
*.xcuserdatad/
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.pbxuser
!default.pbxuser
*.perspectivev3
!default.perspectivev3

# Общие схемы (shared) намеренно НЕ игнорируются — они нужны CI:
# ClipFlow.xcodeproj/xcshareddata/xcschemes/ должен быть в репозитории.

# === Swift Package Manager ===
.build/
.swiftpm/
Package.resolved.backup
# Package.resolved коммитим: он фиксирует версии зависимостей.
# Если зависимостей нет вообще, файла тоже не будет.

# === Подписи и секреты ===
# Профили и сертификаты не должны попадать в git ни при каких условиях.
*.mobileprovision
*.provisionprofile
*.p12
*.cer
*.certSigningRequest
*.pem
*.key
notarization-credentials*
ExportOptions.plist
Secrets.xcconfig
*.local.xcconfig

